## Compressor for sort(1)'s temporary files, used by tdb2.xloader when
## SORT_COMPRESS_ARGS is set. sort runs its --compress-program without
## arguments (and with -d to decompress), so the arguments come from the
## environment, which sort passes on to the compressor:
##   XLOADER_SORT_COMPRESS  the compressor, set by tdb2.xloader
##   SORT_COMPRESS_ARGS     extra arguments, split at spaces, placed before
##                          sort's own arguments (e.g. "-1 -p 4" then "-d")

if [ -z "${XLOADER_SORT_COMPRESS:-}" ] ; then
    echo "xloader-sort-compress: XLOADER_SORT_COMPRESS is not set" 1>&2
    exit 2
fi

## Split SORT_COMPRESS_ARGS at spaces without expanding glob patterns.
set -f
exec "$XLOADER_SORT_COMPRESS" $SORT_COMPRESS_ARGS "$@"
