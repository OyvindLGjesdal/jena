## External environment variables.
##   JENA_CP
##   JENA_HOME
##   JVM_ARGS
##   SORT_COMPRESS_ARGS

## Programs used:
## jq
## sort (or the program given by --sort)
## /usr/bin/gzip (or the program given by --sort-compress, for sort's temporary files)
## xloader-sort-compress (next to this script; only when SORT_COMPRESS_ARGS is set)

## ======= Check environment

function testForProgram() {
    local CMD="$1"
    type -p "$CMD" &> /dev/null
    if [[ $? -ne 0 ]]; then
	echo "Command $CMD not found"
	return 1
    fi
}

## Test for "sort --parallel" (though without that, it's going to be slower!
function testSortParallel() {
    local CMD="$1"
    set +e
    "$CMD" --parallel=3 < /dev/null &>/dev/null
    if [[ $? -ne 0 ]]; then
        echo "No --parallel support in $CMD" 1>&2
	exit 9
    fi
    set -e
}

## Test that a compressor round-trips data the way sort(1) uses it:
## no arguments to compress, "-d" to decompress, both stdin to stdout.
## The optional second argument describes the program in the error message.
function testCompressProgram() {
    local CMD="$1"
    local DESCRIPTION="${2:-$1}"
    local SAMPLE="xloader sort compression check"
    set +e
    local OUT="$(echo "$SAMPLE" | "$CMD" 2>/dev/null | "$CMD" -d 2>/dev/null)"
    set -e
    if [[ "$OUT" != "$SAMPLE" ]]; then
        echo "Compress program $DESCRIPTION failed to round-trip data (compress, then -d)" 1>&2
        exit 9
    fi
}

JAVA="${JAVA:-java}"

COMPLETE="yes"
## The sort program is checked after argument parsing (--sort).
for F in jq gzip java
do
    testForProgram "$F"
    if [[ $? -ne 0 ]] ; then
	COMPLETE="no"
    fi
done

## gzip must be /bin/gzip or /usr/bin/gzip

testForProgram /bin/gzip || testForProgram /usr/bin/gzip
if [[ $? -ne 0 ]]
then
    echo "gzip not installed in /bin/gzip or /usr/bin/gzip"
    COMPLETE="no"
fi

if [[ $COMPLETE != "yes" ]] ; then
    echo "One or more programs missing" 1>&2
    exit 9
fi

unset COMPLETE

## ======== Setup

## Environment variable TMPDIR is ignored.
## it is often a small-ish area unsuitable for large temp files.
## Use the --tmpdir flag

TMPDIR=

## Format used in logging with date(1).
DATE="+%H:%M:%S"

## Functions.
# Usage: log "LEVEL" "MESSAGE"
function log() {
    local LEVEL="$1"
    local MSG="$2"
    printf "$(date $DATE) %-5s %s\n" $LEVEL "$MSG"
}

function debug() {
  if [[ $DEBUG = 1 ]]; then
    log "DEBUG" "$@"
 fi
}

function info() {
  log "INFO" "$@"
}

function warn() {
  log "WARN" "$@" 1>&2
}

function error() {
  log "ERROR" "$@" 1>&2
}

function abort() {
    local EXIT="$1"
    # Trick to check for numeric
    # -eq only returns true if the value is integer equals
    if [ "$EXIT" -eq "$EXIT" ]; then
	shift
    else
	# Caller forgot to provide an exit code so use default of 1
	EXIT=1
  fi
  # Log error and exit
  echo "ERROR" "$@" 1>&2
  exit $EXIT
}

function now() {
    # Current time in seconds. Use +%s%3N for milliseconds.
    date +%s
}

function printUsage() {
    cat <<EOF
$(basename $0) TDB2 Bulk Loader

Usage: ${TDB_CMD} --loc <Directory> [--tmpdir=DIR] [--threads=N] [--sort=PROGRAM] [--sort-compress=PROGRAM] \
       [--sort-compress-nodes] [--workfile-gzip-level=N] [--workfile-gzip-buffer=BYTES] FILE ...

Bulk loader for TDB2.
See https://jena.apache.org/documentation/tdb/tdb-xloader.html

--sort=PROGRAM
    The sort program to use instead of "sort" on the PATH.
    It must accept the GNU sort(1) options used by xloader, including
    --parallel, --buffer-size=50%, --unique, --key, --temporary-directory
    and --compress-program. A wrapper script can adapt another sorter.

--sort-compress=PROGRAM
    The program sort uses to compress its temporary files, instead of gzip.
    It is run with no arguments to compress and with -d to decompress,
    reading stdin and writing stdout; pigz, zstd and lz4 work this way.
    xloader compresses sort temporary files for the index builds only,
    unless --sort-compress-nodes is given.
    Arguments for the program go in SORT_COMPRESS_ARGS (see below).

--sort-compress-nodes
    Also compress the node table sort's temporary files, with the same
    program and SORT_COMPRESS_ARGS. Off by default: on a single disk it
    does not lower the peak space use, which comes later in the load.
    Useful when --tmpdir is on a small or slow separate volume.

--workfile-gzip-level=N, --workfile-gzip-buffer=BYTES
    Gzip settings for the triples/quads workfiles written by the ingest step
    and read by each index build. Defaults: level 1 (fastest), 131072 bytes.
    Level -1 with buffer 512 matches Java's general gzip defaults.

Environment variables:

JENA_HOME
    Location of the Jena installation.
    This defaults to the area where this script is being run from.

JENA_CP
    Class path for running the java steps.
    This defaults to \${JENA_HOME}/lib/\*

JVM_ARGS
    Arguments for the JVM.
    This defaults to "-Xmx4G"
    Do not set to all available RAM.
    Increasing is only necessary for large numbers of long literals.

SORT_COMPRESS_ARGS
    Arguments for the program that compresses sort's temporary files
    (--sort-compress, default gzip), split at spaces. Unset by default.
    Later arguments win for most compressors, so values can be combined:
      export SORT_COMPRESS_ARGS="-1 \$SORT_COMPRESS_ARGS"
    sort cannot pass arguments itself; when this is set, xloader uses the
    wrapper xloader-sort-compress next to this script.

The temporary directory defaults to the datbase directory.

EOF
}

# Determine JENA_HOME

function resolveLink() {
  local NAME=$1

  if [ -L "$NAME" ]; then
    case "$OSTYPE" in
      darwin*|bsd*)
        # BSD style readlink behaves differently to GNU readlink
        # Have to manually follow links
        while [ -L "$NAME" ]; do
          NAME=$(readlink -- "$NAME")
        done
        ;;
      *)
        # Assuming standard GNU readlink with -f for
        # canonicalize
        NAME=$(readlink -f -- "$NAME")
        ;;
    esac
  fi

  echo "$NAME"
}

# If JENA_HOME is empty and no classpath
if [ -z "$JENA_HOME" -a -z "$JENA_CP" ]; then
  SCRIPT="$0"
  # Catch common issue: script has been symlinked
  if [ -L "$SCRIPT" ]; then
    SCRIPT=$(resolveLink "$0")
    # If link is relative
    case "$SCRIPT" in
      /*)
        # Already absolute
        ;;
      *)
        # Relative, make absolute
        SCRIPT=$( dirname "$0" )/$SCRIPT
        ;;
    esac
  fi

  # Work out root from script location
  JENA_HOME="$( cd "$( dirname "$SCRIPT" )/.." && pwd )"
  export JENA_HOME
fi

# If JENA_HOME is a symbolic link need to resolve
if [ -L "${JENA_HOME}" ]; then
  JENA_HOME=$(resolveLink "$JENA_HOME")
  # If link is relative
  case "$JENA_HOME" in
    /*)
      # Already absolute
      ;;
    *)
      # Relative, make absolute
      JENA_HOME=$(dirname "$JENA_HOME")
      ;;
  esac
  export JENA_HOME
  #echo "Resolved symbolic links for JENA_HOME to $JENA_HOME"
fi

## Classpath JENA_CP.
if [ -z "$JENA_CP" ] ; then
   if [ -z "$JENA_HOME" ]; then
       abort 1 "JENA_HOME is not set"
   fi     
   JENA_CP="${JENA_HOME}"/lib/'*'
fi

function exec_java() {
    local ARGS="$@"
    debug "Exec: $ARGS"
    "$JAVA" $JVM_ARGS -cp "$JENA_CP" "$@"
    local RC="$?"
    if [[ $RC != 0 ]] ; then
	error "$JAVA" $JVM_ARGS -cp "$JENA_CP" "$@"
	abort 1 "Java process returned $RC"
    fi
}

# Default values
SORT_THREADS="2"
SORT="sort"
SORT_COMPRESS=""
## Empty means the Java step's own default.
WORKFILE_GZIP_LEVEL=""
WORKFILE_GZIP_BUFFER=""
SORT_COMPRESS_NODES=()

while [ $# -gt 0 ]
do
    ARG=$1
    ## --tmpdir
    ## --loc|--location
    ## --help
    case $ARG in
	-d|--debug)
	    # Debug Mode
	    shift
	    DEBUG=1
	    ;;
	-h|--help)
	    printUsage
	    exit 0
	    ;;
	# Database location
        --loc|-loc)
	    shift
	    LOC="$1"
	    shift
	    ;;
	-*loc=*)
	    # Location = separated
	    LOC=${ARG/-*loc=/}
	    shift
	    ;;
	# Workspace directory
        -tmpdir|--tmpdir)
	    shift
	    TMPDIR="$1"
	    shift
	    ;;
	-*tmpdir=*)
	    TMPDIR=${ARG/-*tmpdir=/}
	    shift
	    ;;
	## Number of sort threads
	--threads|-threads)
	    shift
	    SORT_THREADS="$1"
	    shift
	    ;;
	-*threads=*)
	    SORT_THREADS=${ARG/-*threads=/}
	    shift
	    ;;
	## Sort program
	--sort|-sort)
	    shift
	    SORT="$1"
	    shift
	    ;;
	--sort=*|-sort=*)
	    SORT=${ARG#*=}
	    shift
	    ;;
	## Compressor for sort temporary files
	--sort-compress|-sort-compress)
	    shift
	    SORT_COMPRESS="$1"
	    [[ -z $SORT_COMPRESS ]] && abort 1 "No program given for --sort-compress"
	    shift
	    ;;
	--sort-compress=*|-sort-compress=*)
	    SORT_COMPRESS=${ARG#*=}
	    [[ -z $SORT_COMPRESS ]] && abort 1 "No program given for --sort-compress"
	    shift
	    ;;
	--sort-compress-nodes|-sort-compress-nodes)
	    SORT_COMPRESS_NODES=(--sort-compress-nodes)
	    shift
	    ;;
	## Gzip settings for the ingest workfiles
	--workfile-gzip-level|-workfile-gzip-level)
	    shift
	    WORKFILE_GZIP_LEVEL="$1"
	    shift
	    ;;
	--workfile-gzip-level=*|-workfile-gzip-level=*)
	    WORKFILE_GZIP_LEVEL=${ARG#*=}
	    shift
	    ;;
	--workfile-gzip-buffer|-workfile-gzip-buffer)
	    shift
	    WORKFILE_GZIP_BUFFER="$1"
	    shift
	    ;;
	--workfile-gzip-buffer=*|-workfile-gzip-buffer=*)
	    WORKFILE_GZIP_BUFFER=${ARG#*=}
	    shift
	    ;;
	-version|--version)
	    exec_java jena.version
	    exit
	    ;;
	--)
	    # Arguments separator
	    shift
	    break
	    ;;
	-*)
	    abort 1 "Unrecognized option $ARG, if this was meant to be a data file separate options from data files with --"
	    ;;
	*)
	    break
	    ;;
    esac
done

## Check argument SORT
if [[ -z $SORT ]] ; then
    abort 1 "No program given for --sort"
fi
testForProgram "$SORT" || abort 9 "Sort program not found: $SORT"
testSortParallel "$SORT"

## Optional argument SORT_COMPRESS; passed to the Java steps only if given.
## Optional environment variable SORT_COMPRESS_ARGS: sort runs its compress
## program without arguments, so they go through the wrapper
## xloader-sort-compress, which finds the program and the arguments in the
## environment that sort passes on. Unset: no wrapper, behaviour unchanged.
SORT_COMPRESS_PROGRAM=()
if [[ -n ${SORT_COMPRESS_ARGS:-} ]] ; then
    if [[ -z $SORT_COMPRESS ]] ; then
        ## The default compressor, as the Java steps choose it.
        if [[ -x /usr/bin/gzip ]] ; then SORT_COMPRESS=/usr/bin/gzip ; else SORT_COMPRESS=/bin/gzip ; fi
    fi
    testForProgram "$SORT_COMPRESS" || abort 9 "Compress program not found: $SORT_COMPRESS"
    SORT_COMPRESS_WRAPPER="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/xloader-sort-compress"
    [[ -x $SORT_COMPRESS_WRAPPER ]] || abort 9 "SORT_COMPRESS_ARGS is set but $SORT_COMPRESS_WRAPPER is missing or not executable"
    export XLOADER_SORT_COMPRESS="$(type -p "$SORT_COMPRESS")"
    export SORT_COMPRESS_ARGS
    testCompressProgram "$SORT_COMPRESS_WRAPPER" "'$XLOADER_SORT_COMPRESS $SORT_COMPRESS_ARGS' (SORT_COMPRESS_ARGS)"
    SORT_COMPRESS_PROGRAM=(--sort-compress "$SORT_COMPRESS_WRAPPER")
elif [[ -n $SORT_COMPRESS ]] ; then
    testForProgram "$SORT_COMPRESS" || abort 9 "Compress program not found: $SORT_COMPRESS"
    testCompressProgram "$SORT_COMPRESS"
    SORT_COMPRESS_PROGRAM=(--sort-compress "$SORT_COMPRESS")
fi

## Optional workfile gzip settings; passed to the ingest step only if given.
WORKFILE_GZIP_ARGS=()
if [[ -n $WORKFILE_GZIP_LEVEL ]] ; then
    [[ $WORKFILE_GZIP_LEVEL =~ ^(-1|[0-9])$ ]] || abort 1 "Bad value for --workfile-gzip-level (-1 or 0-9): $WORKFILE_GZIP_LEVEL"
    WORKFILE_GZIP_ARGS+=("--workfile-gzip-level=$WORKFILE_GZIP_LEVEL")
fi
if [[ -n $WORKFILE_GZIP_BUFFER ]] ; then
    [[ $WORKFILE_GZIP_BUFFER =~ ^[1-9][0-9]*$ ]] || abort 1 "Bad value for --workfile-gzip-buffer (bytes): $WORKFILE_GZIP_BUFFER"
    WORKFILE_GZIP_ARGS+=("--workfile-gzip-buffer=$WORKFILE_GZIP_BUFFER")
fi

## Check argument SORT_THREADS
if [[ $SORT_THREADS != "-1" ]] ; then
    if [[ ! $SORT_THREADS =~ ^[-+]?[0-9]+$ ]] ; then
	abort 1 "Bad value for --threads : $SORT_THREADS"
    fi
fi
	       
if [[ $# -eq 0 ]] ; then
    abort 1 "No files to load"
fi

DATAFILES="$@"

if [[ -z $LOC ]] ; then
    abort 1 "No directory name for the database"
fi

## Don't mess up an existing database!
if [ -e "$LOC" ]; then
    abort 3 "Directory $LOC already exists"
fi

[[ -z $TMPDIR ]] && TMPDIR=$LOC

if [[ ! -e $TMPDIR ]] ; then
    mkdir -p "$TMPDIR"
    #abort 2 echo "TMPDIR $TMPDIR does not exist"
fi

if [[ ! -d $TMPDIR ]] ; then
    abort 2 "TMPDIR $TMPDIR is not a directory"
fi

if [[ ! -w $TMPDIR ]] ; then
    abort 2 "TMPDIR $TMPDIR is not writable"
fi

export TMPDIR

## TDB1 / TDB2
## @@
SYSTEM=TDB2
case "$SYSTEM" in
    "TDB2")
	## @@
	PKG=tdb2.xloader
	## @@
## 	CMD_LOAD_TERMS=
## 	CMD_INGEST_DATA=
## 	CMD_BUILD_INDEX=
	
	;;
    "TDB1")
	## Not ported.
	abort 9 "System '$SYSTEM' not supported"
## 	PKG=org.apache.jena.tdb.xloader
## 	CMD_LOAD_TERMS=""
## 	CMD_INGEST_DATA=
## 	CMD_BUILD_INDEX=
	;;
    *)
	abort 2 "System '$SYSTEM' not recognized"
	;;
esac

info "Setup:"
info "  Database: $LOC"
info "  Data:     $DATAFILES"
info "  TMPDIR:   $TMPDIR"
info "  Sort:     $(type -p "$SORT")"
if [[ -n ${SORT_COMPRESS_ARGS:-} ]] ; then
    info "  Compress: $XLOADER_SORT_COMPRESS $SORT_COMPRESS_ARGS (sort temporary files, via $(basename "$SORT_COMPRESS_WRAPPER"))"
elif [[ -n $SORT_COMPRESS ]] ; then
    info "  Compress: $(type -p "$SORT_COMPRESS") (sort temporary files)"
fi
if [[ ${#SORT_COMPRESS_NODES[@]} -gt 0 ]] ; then
    info "  Node table sort: compressed temporary files"
fi
if [[ ${#WORKFILE_GZIP_ARGS[@]} -gt 0 ]] ; then
    info "  Workfile gzip: ${WORKFILE_GZIP_ARGS[*]}"
fi

## Large heap not required.
## Max use is in the digest phase for the enlarged Node to Node id cache.
JVM_ARGS="${JVM_ARGS:--Xmx4G}"

## Unique string used to mark where steps end and where the key information is to be found.
STEP_END_MARKER="=-=-=-=-=-=-=-="

## Time point.

TIME_START="$(now)"

## ======== Node table loading.
if [ "$SYSTEM" == "TDB2" ]; then
    ## TDB2 only.
    info
    T="$(now)"
    info "Load node table"
    exec_java $PKG.CmdxBuildNodeTable --loc $LOC --tmpdir "$TMPDIR" --threads $SORT_THREADS --sort "$SORT" "${SORT_COMPRESS_PROGRAM[@]}" "${SORT_COMPRESS_NODES[@]}" $DATAFILES
    TIME_NODE_TABLE=$(($(now)-$T))
    info "$STEP_END_MARKER"
fi

## ======== Ingest data, creates workfiles
info
info "Ingest data"
T="$(now)"
exec_java $PKG.CmdxIngestData --loc $LOC --tmpdir "$TMPDIR" "${WORKFILE_GZIP_ARGS[@]}" --triples "$TMPDIR/triples.tmp" --quads "$TMPDIR/quads.tmp" $DATAFILES
TIME_INGEST=$(($(now)-$T))
info "$STEP_END_MARKER"

## ======== Indexes
INFO="$TMPDIR/load.json"

## Bash assocative array
declare -A TIME_IDX

function index() {
    local IDX="$1"
    info
    info "Build $IDX"
    info "(Very long pause likely at this point)"
    local T="$(now)"
    exec_java $PKG.CmdxBuildIndex --loc $LOC --tmpdir "$TMPDIR" --threads $SORT_THREADS --sort "$SORT" "${SORT_COMPRESS_PROGRAM[@]}" --index $IDX \
	      "$TMPDIR/triples.tmp" "$TMPDIR/quads.tmp"
    info "$STEP_END_MARKER"
    local T_IDX=$(($(now)-$T))
    TIME_IDX[$IDX]=$T_IDX
}

## Decide which indexes to generate.
TRIPLES_DFT="SPO POS OSP"
QUADS_DFT="GSPO GPOS GOSP SPOG POSG OSPG"

TRIPLES_IDX="${TRIPLES_IDX:-$TRIPLES_DFT}"
QUADS_IDX="${QUADS_IDX:-$QUADS_DFT}"

if [ -e "$INFO" ] ; then
    ## Skip a phase if there are no items to index.
    TRIPLES="$(jq .triples < $INFO)"
    QUADS="$(jq .quads < $INFO)"
    if [[ $TRIPLES -eq 0 ]] ; then
	TRIPLES_IDX=""
    fi
    if [[ $QUADS -eq 0 ]] ; then
	QUADS_IDX=""
    fi
fi

## ==== Triples

for IDX in $TRIPLES_IDX ; do
    index $IDX
done

## ==== Quads

for IDX in $QUADS_IDX ; do
    index $IDX
done

## ======== Finish

## Delete temp files.
## rm -f "$TMPDIR"/triples.tmp* "$TMPDIR"/quads.tmp*

info
TIME_FINISH="$(now)"

## ======== Reporting
TIME_TOTAL=$(($TIME_FINISH-$TIME_START))

## Ingest
if [ -n "$TIME_NODE_TABLE" ]; then
    info "Load node table  = $TIME_NODE_TABLE seconds"
fi

SECS=$TIME_TOTAL
TIME_HMS="$(printf '%02dh %02dm %02ds\n' $((SECS/3600)) $((SECS%3600/60)) $((SECS%60)))"

info "Load ingest data = $TIME_INGEST seconds"

## Indexes
for IDX in $TRIPLES_IDX ; do
     info "Build index ${IDX}  = ${TIME_IDX[${IDX}]} seconds"
done
for IDX in $QUADS_IDX ; do
     info "Build index ${IDX} = ${TIME_IDX[${IDX}]} seconds"
done

## Whole run
info "Overall          $TIME_TOTAL seconds"
info "Overall          $TIME_HMS"

if [[ -e $INFO ]]
then
    printf -v TRIPLES_STR "%'d" "$TRIPLES"
    printf -v QUADS_STR "%'d" "$QUADS"
    info "Triples loaded   = $TRIPLES_STR"
    info "Quads loaded     = $QUADS_STR"
    TUPLES=$(($TRIPLES+$QUADS))
    RATE=$(($TUPLES / $TIME_TOTAL))
    printf -v RATE_STR "%'d" "$RATE"
    info "Overall Rate     $RATE_STR tuples per second"
fi
